generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYER
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role
  jobs         Job[]         @relation("EmployerJobs")
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Job {
  id           String        @id @default(cuid())
  title        String
  description  String
  location     String
  jobType      JobType
  postedBy     User          @relation("EmployerJobs", fields: [postedById], references: [id])
  postedById   String
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Application {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id])
  jobId       String
  candidate   User     @relation(fields: [candidateId], references: [id])
  candidateId String
  resumeLink  String
  note        String?
  createdAt   DateTime @default(now())

  @@unique([jobId, candidateId])
}